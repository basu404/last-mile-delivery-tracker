// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  agent
  admin
}

enum OrderType {
  B2B
  B2C
}

enum PaymentType {
  prepaid
  cod
}

enum RateType {
  intra_zone
  inter_zone
}

enum OrderStatus {
  created
  assigned
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  rescheduled
  cancelled
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  phone         String?
  currentLat    Float?
  currentLng    Float?
  assignedZoneId String?
  assignedZone  Zone?    @relation(fields: [assignedZoneId], references: [id])
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())

  ordersAsCustomer Order[] @relation("CustomerOrders")
  ordersAsAgent    Order[] @relation("AgentOrders")
  statusChanges    OrderStatusHistory[]
  notifications    Notification[]
}

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  pincodes       ZonePincode[]
  agents         User[]
  pickupOrders   Order[] @relation("PickupZone")
  dropOrders     Order[] @relation("DropZone")
  rateCardsFrom  RateCard[] @relation("FromZone")
  rateCardsTo    RateCard[] @relation("ToZone")
}

model ZonePincode {
  id      String @id @default(uuid())
  pincode String @unique
  zoneId  String
  zone    Zone   @relation(fields: [zoneId], references: [id])
}

model RateCard {
  id                String      @id @default(uuid())
  orderType         OrderType
  fromZoneId        String
  toZoneId          String
  fromZone          Zone        @relation("FromZone", fields: [fromZoneId], references: [id])
  toZone            Zone        @relation("ToZone", fields: [toZoneId], references: [id])
  rateType          RateType
  basePrice         Float
  pricePerKg        Float
  codSurchargeFlat  Float       @default(0)
  codSurchargePct   Float       @default(0)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())

  orders Order[]

  @@unique([orderType, fromZoneId, toZoneId])
}

model Order {
  id                  String       @id @default(uuid())
  customerId          String
  customer            User         @relation("CustomerOrders", fields: [customerId], references: [id])
  createdById         String

  pickupAddress       String
  pickupZoneId        String
  pickupZone          Zone         @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropAddress         String
  dropZoneId          String
  dropZone            Zone         @relation("DropZone", fields: [dropZoneId], references: [id])

  lengthCm            Float
  breadthCm           Float
  heightCm            Float
  actualWeightKg      Float
  volumetricWeightKg  Float
  chargeableWeightKg  Float

  orderType           OrderType
  paymentType         PaymentType

  rateCardId          String
  rateCard            RateCard     @relation(fields: [rateCardId], references: [id])
  baseCharge          Float
  codSurcharge        Float
  totalCharge         Float

  status              OrderStatus  @default(created)
  assignedAgentId      String?
  assignedAgent        User?        @relation("AgentOrders", fields: [assignedAgentId], references: [id])

  scheduledDate        DateTime?
  failureReason         String?

  createdAt            DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  statusHistory         OrderStatusHistory[]
  notifications         Notification[]
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id])
  status     OrderStatus
  changedById String
  changedBy   User        @relation(fields: [changedById], references: [id])
  notes      String?
  timestamp  DateTime    @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id])
  channel     String   @default("email")
  message     String
  status      String   // sent | failed
  sentAt      DateTime @default(now())
}

